def cmd_tasks(args):
    sub = args[0] if args else "help"
    rest = args[1:]
    {
        "lists":      lambda: tasks_lists(rest),
        "list":       lambda: tasks_list(rest),
        "create":     lambda: tasks_create(rest),
        "complete":   lambda: tasks_complete(rest),
        "uncomplete": lambda: tasks_uncomplete(rest),
        "delete":     lambda: tasks_delete(rest),
        "clear":      lambda: tasks_clear(rest),
    }.get(sub, lambda: tasks_help())()


def tasks_help():
    print("""\
Usage: google-api tasks <command>

  lists                             List all task lists
  list <list-id> [--all]            List tasks (default: incomplete only)
  create <list-id> --title T [--notes N] [--due YYYY-MM-DD]
  complete <task-id> <list-id>
  uncomplete <task-id> <list-id>
  delete <task-id> <list-id>
  clear <list-id>                   Clear completed tasks
""")


def tasks_lists(args):
    t = get_access_token()
    result = http_get("https://tasks.googleapis.com/tasks/v1/users/@me/lists", token=t)
    if "error" in result:
        die(result["error"].get("message", str(result)))
    for lst in result.get("items", []):
        print(f"{lst['id']:<50} {lst.get('title','')}")


def tasks_list(args):
    if not args:
        die("Usage: google-api tasks list <list-id> [--all]")
    list_id = args[0]
    show_all = "--all" in args
    t = get_access_token()
    params = {} if show_all else {"showCompleted": "false"}
    result = http_get(
        f"https://tasks.googleapis.com/tasks/v1/lists/{list_id}/tasks",
        token=t, params=params
    )
    if "error" in result:
        die(result["error"].get("message", str(result)))
    for task in result.get("items", []):
        done = "✓" if task.get("status") == "completed" else "○"
        due = task.get("due", "")[:10]
        print(f"{done} {due}  {task.get('title','')}")
        if task.get("notes"):
            print(f"    {task['notes']}")


def tasks_create(args):
    if not args:
        die("Usage: google-api tasks create <list-id> --title T")
    list_id = args[0]
    title = notes = due = ""
    i = 1
    while i < len(args):
        if args[i] == "--title" and i + 1 < len(args):
            title = args[i + 1]; i += 2
        elif args[i] == "--notes" and i + 1 < len(args):
            notes = args[i + 1]; i += 2
        elif args[i] == "--due" and i + 1 < len(args):
            due = args[i + 1]; i += 2
        else:
            i += 1
    if not title:
        die("--title required")
    body = {"title": title}
    if notes:
        body["notes"] = notes
    if due:
        body["due"] = due if "T" in due else due + "T00:00:00.000Z"
    t = get_access_token()
    result = http_req("POST",
        f"https://tasks.googleapis.com/tasks/v1/lists/{list_id}/tasks",
        token=t, body=body
    )
    if "error" in result:
        die(result["error"].get("message", str(result)))
    print(f"✓ Created task '{result.get('title')}' — {result.get('id')}")


def tasks_complete(args):
    if len(args) < 2:
        die("Usage: google-api tasks complete <task-id> <list-id>")
    task_id, list_id = args[0], args[1]
    t = get_access_token()
    result = http_req("PATCH",
        f"https://tasks.googleapis.com/tasks/v1/lists/{list_id}/tasks/{task_id}",
        token=t, body={"status": "completed"}
    )
    if "error" in result:
        die(result["error"].get("message", str(result)))
    print(f"✓ Marked complete")


def tasks_uncomplete(args):
    if len(args) < 2:
        die("Usage: google-api tasks uncomplete <task-id> <list-id>")
    task_id, list_id = args[0], args[1]
    t = get_access_token()
    result = http_req("PATCH",
        f"https://tasks.googleapis.com/tasks/v1/lists/{list_id}/tasks/{task_id}",
        token=t, body={"status": "needsAction", "completed": None}
    )
    if "error" in result:
        die(result["error"].get("message", str(result)))
    print(f"✓ Marked incomplete")


def tasks_delete(args):
    if len(args) < 2:
        die("Usage: google-api tasks delete <task-id> <list-id>")
    task_id, list_id = args[0], args[1]
    t = get_access_token()
    result = http_req("DELETE",
        f"https://tasks.googleapis.com/tasks/v1/lists/{list_id}/tasks/{task_id}",
        token=t
    )
    if "error" in result:
        die(result["error"].get("message", str(result)))
    print(f"✓ Deleted task {task_id}")


def tasks_clear(args):
    if not args:
        die("Usage: google-api tasks clear <list-id>")
    list_id = args[0]
    t = get_access_token()
    result = http_req("POST",
        f"https://tasks.googleapis.com/tasks/v1/lists/{list_id}/clear",
        token=t, body={}
    )
    if "error" in result:
        die(result["error"].get("message", str(result)))
    print(f"✓ Cleared completed tasks")


