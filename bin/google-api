def cmd_blogger(args):
    sub = args[0] if args else "help"
    rest = args[1:]
    {
        "blogs":  lambda: blogger_blogs(rest),
        "posts":  lambda: blogger_posts(rest),
        "post":   lambda: blogger_post(rest),
        "delete": lambda: blogger_delete(rest),
    }.get(sub, lambda: blogger_help())()


def blogger_help():
    print("""\
Usage: google-api blogger <command>

  blogs                              List your blogs
  posts <blog-id> [--max N]          List posts
  post <blog-id> --title T --content C [--draft]
  delete <blog-id> <post-id>
""")


def blogger_blogs(args):
    t = get_access_token()
    result = http_get("https://www.googleapis.com/blogger/v3/users/self/blogs", token=t)
    if "error" in result:
        die(result["error"].get("message", str(result)))
    for blog in result.get("items", []):
        print(f"{blog['id']}  {blog.get('name','')}  {blog.get('url','')}")


def blogger_posts(args):
    if not args:
        die("Usage: google-api blogger posts <blog-id>")
    blog_id = args[0]
    max_results = 10
    for i, a in enumerate(args):
        if a == "--max" and i + 1 < len(args):
            max_results = int(args[i + 1])
    t = get_access_token()
    result = http_get(
        f"https://www.googleapis.com/blogger/v3/blogs/{blog_id}/posts",
        token=t, params={"maxResults": max_results, "fetchBodies": "false"}
    )
    if "error" in result:
        die(result["error"].get("message", str(result)))
    for post in result.get("items", []):
        pub = post.get("published", "")[:10]
        print(f"{post['id']}  {pub}  {post.get('title','')}")


def blogger_post(args):
    if not args:
        die("Usage: google-api blogger post <blog-id> --title T --content C")
    blog_id = args[0]
    title = content = ""
    draft = "--draft" in args
    i = 1
    while i < len(args):
        if args[i] == "--title" and i + 1 < len(args):
            title = args[i + 1]; i += 2
        elif args[i] == "--content" and i + 1 < len(args):
            content = args[i + 1]; i += 2
        else:
            i += 1
    if not title:
        die("--title required")

    status = "DRAFT" if draft else "LIVE"
    print(f"Publish post '{title}' to blog {blog_id} [{status}]?")
    if input("Confirm [y/N]: ").strip().lower() != "y":
        print("Aborted.")
        return

    body = {"title": title, "content": content}
    params = {"isDraft": "true"} if draft else {}
    t = get_access_token()
    result = http_req("POST",
        f"https://www.googleapis.com/blogger/v3/blogs/{blog_id}/posts",
        token=t, body=body, params=params
    )
    if "error" in result:
        die(result["error"].get("message", str(result)))
    print(f"✓ Posted — {result.get('url')}")


def blogger_delete(args):
    if len(args) < 2:
        die("Usage: google-api blogger delete <blog-id> <post-id>")
    blog_id, post_id = args[0], args[1]
    print(f"Delete post {post_id}?")
    if input("Confirm [y/N]: ").strip().lower() != "y":
        print("Aborted.")
        return
    t = get_access_token()
    result = http_req("DELETE",
        f"https://www.googleapis.com/blogger/v3/blogs/{blog_id}/posts/{post_id}",
        token=t
    )
    if "error" in result:
        die(result["error"].get("message", str(result)))
    print(f"✓ Deleted post {post_id}")


# ---------------------------------------------------------------------------
# Contacts (People API)
# ---------------------------------------------------------------------------

def cmd_contacts(args):
    sub = args[0] if args else "list"
    rest = args[1:]
    {
        "list":   lambda: contacts_list(rest),
        "search": lambda: contacts_search(rest),
        "get":    lambda: contacts_get(rest),
    }.get(sub, lambda: contacts_help())()


def contacts_help():
    print("""\
Usage: google-api contacts <command>

  list [--max N]
  search <query>
  get <resource-name>
""")


def contacts_list(args):
    max_results = 20
    as_json = "--json" in args
    for i, a in enumerate(args):
        if a == "--max" and i + 1 < len(args):
            max_results = int(args[i + 1])
    t = get_access_token()
    result = http_get(
        "https://people.googleapis.com/v1/people/me/connections",
        token=t, params={
            "pageSize": max_results,
            "personFields": "names,emailAddresses,phoneNumbers"
        }
    )
    if "error" in result:
        die(result["error"].get("message", str(result)))
    if as_json:
        jprint(result)
        return
    for p in result.get("connections", []):
        name = (p.get("names") or [{}])[0].get("displayName", "")
        emails = [e["value"] for e in p.get("emailAddresses", [])]
        phones = [ph["value"] for ph in p.get("phoneNumbers", [])]
        print(f"{name:<30} {', '.join(emails):<35} {', '.join(phones)}")


def contacts_search(args):
    if not args:
        die("Usage: google-api contacts search <query>")
    query = args[0]
    t = get_access_token()
    result = http_get(
        "https://people.googleapis.com/v1/people:searchContacts",
        token=t, params={"query": query, "readMask": "names,emailAddresses,phoneNumbers"}
    )
    if "error" in result:
        die(result["error"].get("message", str(result)))
    for r in result.get("results", []):
        p = r.get("person", {})
        name = (p.get("names") or [{}])[0].get("displayName", "")
        emails = [e["value"] for e in p.get("emailAddresses", [])]
        print(f"{name:<30} {', '.join(emails)}")


def contacts_get(args):
    if not args:
        die("Usage: google-api contacts get <resource-name>")
    resource = args[0]
    t = get_access_token()
    result = http_get(
        f"https://people.googleapis.com/v1/{resource}",
        token=t, params={"personFields": "names,emailAddresses,phoneNumbers,organizations,birthdays"}
    )
    if "error" in result:
        die(result["error"].get("message", str(result)))
    jprint(result)


# ---------------------------------------------------------------------------
# Photos (via Drive — Photos Library API requires Google app verification)
# ---------------------------------------------------------------------------

def cmd_photos(args):
    sub = args[0] if args else "list"
    rest = args[1:]
    {
        "list":   lambda: photos_list(rest),
        "search": lambda: photos_search(rest),
    }.get(sub, lambda: photos_help())()


def photos_help():
    print("""\
Usage: google-api photos <command>

  list [--max N] [--json]          List recent images from Drive
  search --date YYYY-MM-DD [--max N]  Search images by date (createdTime)

Note: Uses Google Drive API (mimeType image/*). Albums not available via
Drive. For full Photos Library access use the google-photos-api skill.
""")


def photos_list(args):
    max_results = 20
    as_json = "--json" in args
    for i, a in enumerate(args):
        if a == "--max" and i + 1 < len(args):
            max_results = int(args[i + 1])
    t = get_access_token()
    result = http_get(
        "https://www.googleapis.com/drive/v3/files",
        token=t, params={
            "q": "mimeType contains 'image/' and trashed=false",
            "pageSize": max_results,
            "orderBy": "createdTime desc",
            "fields": "files(id,name,mimeType,createdTime,size)",
        }
    )
    if "error" in result:
        die(result["error"].get("message", str(result)))
    if as_json:
        jprint(result.get("files", []))
        return
    for f in result.get("files", []):
        created = f.get("createdTime", "")[:10]
        size = int(f.get("size", 0))
        print(f"{f['id'][:20]}  {created}  {size:>10}  {f['name']}")


def photos_search(args):
    date = ""
    max_results = 20
    i = 0
    while i < len(args):
        if args[i] == "--date" and i + 1 < len(args):
            date = args[i + 1]; i += 2
        elif args[i] == "--max" and i + 1 < len(args):
            max_results = int(args[i + 1]); i += 2
        else:
            i += 1

    q = "mimeType contains 'image/' and trashed=false"
    if date:
        try:
            datetime.strptime(date, "%Y-%m-%d")
            q += f" and createdTime >= '{date}T00:00:00Z' and createdTime < '{date}T23:59:59Z'"
        except ValueError:
            die("--date must be YYYY-MM-DD")

    t = get_access_token()
    result = http_get(
        "https://www.googleapis.com/drive/v3/files",
        token=t, params={
            "q": q,
            "pageSize": max_results,
            "orderBy": "createdTime desc",
            "fields": "files(id,name,mimeType,createdTime,size)",
        }
    )
    if "error" in result:
        die(result["error"].get("message", str(result)))
    for f in result.get("files", []):
        created = f.get("createdTime", "")[:10]
        size = int(f.get("size", 0))
        print(f"{f['id'][:20]}  {created}  {size:>10}  {f['name']}")


# ---------------------------------------------------------------------------
# Maps (API key — no OAuth)
# ---------------------------------------------------------------------------

def cmd_maps(args):
    sub = args[0] if args else "help"
    rest = args[1:]
    {
        "geocode":    lambda: maps_geocode(rest),
        "directions": lambda: maps_directions(rest),
        "places":     lambda: maps_places(rest),
    }.get(sub, lambda: maps_help())()


def maps_help():
    print("""\
Usage: google-api maps <command>  (requires maps_api_key in config.json)

  geocode <address>
  directions <origin> <destination> [--mode driving|walking|transit|bicycling]
  places <query> [--location lat,lng] [--radius M]
""")


def get_maps_key():
    cfg = load_config()
    key = cfg.get("maps_api_key")
    if not key:
        die("maps_api_key not set in ~/.config/google-api/config.json")
    return key


def maps_geocode(args):
    if not args:
        die("Usage: google-api maps geocode <address>")
    address = " ".join(args)
    key = get_maps_key()
    result = http_get(
        "https://maps.googleapis.com/maps/api/geocode/json",
        params={"address": address, "key": key}
    )
    if result.get("status") != "OK":
        die(f"Geocode failed: {result.get('status')} — {result.get('error_message','')}")
    for r in result.get("results", []):
        loc = r["geometry"]["location"]
        print(f"{r['formatted_address']}")
        print(f"  lat={loc['lat']}, lng={loc['lng']}")


def maps_directions(args):
    if len(args) < 2:
        die("Usage: google-api maps directions <origin> <destination> [--mode driving]")
    origin = args[0]
    dest = args[1]
    mode = "driving"
    for i, a in enumerate(args):
        if a == "--mode" and i + 1 < len(args):
            mode = args[i + 1]
    key = get_maps_key()
    result = http_get(
        "https://maps.googleapis.com/maps/api/directions/json",
        params={"origin": origin, "destination": dest, "mode": mode, "key": key}
    )
    if result.get("status") != "OK":
        die(f"Directions failed: {result.get('status')} — {result.get('error_message','')}")
    for route in result.get("routes", []):
        for leg in route.get("legs", []):
            print(f"{leg['start_address']} → {leg['end_address']}")
            print(f"  Distance: {leg['distance']['text']}")
            print(f"  Duration: {leg['duration']['text']}")
            for i, step in enumerate(leg.get("steps", []), 1):
                import html
                instr = html.unescape(step.get("html_instructions",""))
                # strip HTML tags
                import re
                instr = re.sub(r"<[^>]+>", " ", instr).strip()
                print(f"  {i:>2}. {instr} ({step['distance']['text']})")


def maps_places(args):
    if not args:
        die("Usage: google-api maps places <query>")
    query = args[0]
    location = radius = ""
    for i, a in enumerate(args):
        if a == "--location" and i + 1 < len(args):
            location = args[i + 1]
        elif a == "--radius" and i + 1 < len(args):
            radius = args[i + 1]
    key = get_maps_key()
    params = {"query": query, "key": key}
    if location:
        params["location"] = location
    if radius:
        params["radius"] = radius
    result = http_get(
        "https://maps.googleapis.com/maps/api/place/textsearch/json",
        params=params
    )
    if result.get("status") not in ("OK", "ZERO_RESULTS"):
        die(f"Places failed: {result.get('status')} — {result.get('error_message','')}")
    for place in result.get("results", []):
        rating = place.get("rating", "-")
        print(f"{place['name']}")
        print(f"  {place.get('formatted_address','')}")
        print(f"  Rating: {rating}  Types: {', '.join(place.get('types',[])[:3])}")
        print()


# ---------------------------------------------------------------------------
# Top-level dispatch
# ---------------------------------------------------------------------------

COMMANDS = {
    "auth":      cmd_auth,
    "services":  cmd_services,
    "gmail":     cmd_gmail,
    "calendar":  cmd_calendar,
    "drive":     cmd_drive,
    "sheets":    cmd_sheets,
    "docs":      cmd_docs,
    "keep":      cmd_keep,
    "tasks":     cmd_tasks,
    "blogger":   cmd_blogger,
    "contacts":  cmd_contacts,
    "photos":    cmd_photos,
}


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(f"""\
google-api — unified Google API CLI

Usage: google-api <service> <command> [args]

Services:
  auth        Authenticate (device flow) and manage tokens
  services    List enabled Google Cloud APIs (Service Usage API)
  gmail       Gmail — search, read, send
  calendar    Google Calendar — list cals, events, create
  drive       Google Drive — search, upload, mkdir, share
  sheets      Google Sheets — get, update, append, clear
  docs        Google Docs — cat, export
  keep        Google Keep — list, create, delete
  tasks       Google Tasks — lists, create, complete
  blogger     Blogger — blogs, posts, publish
  contacts    Google Contacts (People API)
  photos      Images via Drive (list, search by date)

Related skills (separate auth models):
  google-maps-api    Maps geocode/directions/places (API key)
  google-photos-api  Full Photos Library (restricted scope, needs verification)
  google-firebase-api  Firebase/Firestore (service account)

Config: {CONFIG_DIR}/
  credentials.json  — OAuth client secret (from Cloud Console)
  token.json        — auto-managed
  config.json       — project_id, etc.
""")
        return

    cmd = sys.argv[1]
    args = sys.argv[2:]

    handler = COMMANDS.get(cmd)
    if not handler:
        die(f"Unknown service '{cmd}'. Run: google-api --help")

    handler(args)


if __name__ == "__main__":
    main()
