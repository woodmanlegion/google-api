def cmd_docs(args):
    sub = args[0] if args else "help"
    rest = args[1:]
    {
        "cat":    lambda: docs_cat(rest),
        "export": lambda: docs_export(rest),
        "info":   lambda: docs_info(rest),
    }.get(sub, lambda: docs_help())()


def docs_help():
    print("""\
Usage: google-api docs <command>

  cat <doc-id>                           Print document as plain text
  export <doc-id> [--format txt|pdf|docx] [--out FILE]
  info <doc-id>                          Document metadata
""")


def docs_cat(args):
    if not args:
        die("Usage: google-api docs cat <doc-id>")
    doc_id = args[0]
    t = get_access_token()
    # Export as plain text via Drive
    url = f"https://www.googleapis.com/drive/v3/files/{doc_id}/export"
    req = urllib.request.Request(url + "?" + urllib.parse.urlencode({"mimeType": "text/plain"}))
    req.add_header("Authorization", f"Bearer {t}")
    try:
        with urllib.request.urlopen(req) as r:
            print(r.read().decode("utf-8", errors="replace"))
    except urllib.error.HTTPError as e:
        die(json.loads(e.read().decode()))


def docs_export(args):
    if not args:
        die("Usage: google-api docs export <doc-id> [--format txt] [--out FILE]")
    doc_id = args[0]
    fmt = "txt"
    out_file = None
    i = 1
    while i < len(args):
        if args[i] == "--format" and i + 1 < len(args):
            fmt = args[i + 1]; i += 2
        elif args[i] == "--out" and i + 1 < len(args):
            out_file = args[i + 1]; i += 2
        else:
            i += 1

    mime_map = {
        "txt":  "text/plain",
        "pdf":  "application/pdf",
        "docx": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "html": "text/html",
        "md":   "text/markdown",
    }
    mime = mime_map.get(fmt, "text/plain")

    t = get_access_token()
    url = f"https://www.googleapis.com/drive/v3/files/{doc_id}/export"
    req = urllib.request.Request(url + "?" + urllib.parse.urlencode({"mimeType": mime}))
    req.add_header("Authorization", f"Bearer {t}")
    try:
        with urllib.request.urlopen(req) as r:
            data = r.read()
    except urllib.error.HTTPError as e:
        die(json.loads(e.read().decode()))

    if out_file:
        with open(out_file, "wb") as f:
            f.write(data)
        print(f"✓ Exported to {out_file}")
    else:
        sys.stdout.buffer.write(data)


def docs_info(args):
    if not args:
        die("Usage: google-api docs info <doc-id>")
    doc_id = args[0]
    t = get_access_token()
    result = http_get(
        f"https://docs.googleapis.com/v1/documents/{doc_id}",
        token=t
    )
    if "error" in result:
        die(result["error"].get("message", str(result)))
    print(f"Title:    {result.get('title')}")
    print(f"Doc ID:   {result.get('documentId')}")
    body_content = result.get("body", {}).get("content", [])
    print(f"Elements: {len(body_content)}")


