def cmd_keep(args):
    sub = args[0] if args else "help"
    rest = args[1:]
    {
        "list":   lambda: keep_list(rest),
        "get":    lambda: keep_get(rest),
        "create": lambda: keep_create(rest),
        "delete": lambda: keep_delete(rest),
    }.get(sub, lambda: keep_help())()


def keep_help():
    print("""\
Usage: google-api keep <command>

  list [--trashed]
  get <note-id>
  create --title T [--text Body | --list item1,item2]
  delete <note-id>
""")


def keep_list(args):
    trashed = "--trashed" in args
    as_json = "--json" in args
    t = get_access_token()
    params = {}
    if trashed:
        params["filter"] = "trashed=true"
    result = http_get("https://keep.googleapis.com/v1/notes", token=t, params=params)
    if "error" in result:
        die(result["error"].get("message", str(result)))
    if as_json:
        jprint(result)
        return
    for note in result.get("notes", []):
        title = note.get("title", "(no title)")
        name = note.get("name", "")
        updated = note.get("updateTime", "")[:10]
        print(f"{name}  {updated}  {title}")


def keep_get(args):
    if not args:
        die("Usage: google-api keep get <note-id>")
    note_id = args[0]
    if not note_id.startswith("notes/"):
        note_id = f"notes/{note_id}"
    t = get_access_token()
    result = http_get(f"https://keep.googleapis.com/v1/{note_id}", token=t)
    if "error" in result:
        die(result["error"].get("message", str(result)))
    jprint(result)


def keep_create(args):
    title = text = list_items = ""
    i = 0
    while i < len(args):
        if args[i] == "--title" and i + 1 < len(args):
            title = args[i + 1]; i += 2
        elif args[i] == "--text" and i + 1 < len(args):
            text = args[i + 1]; i += 2
        elif args[i] == "--list" and i + 1 < len(args):
            list_items = args[i + 1]; i += 2
        else:
            i += 1

    if list_items:
        items = [{"text": {"text": item.strip()}, "checked": False}
                 for item in list_items.split(",")]
        body = {"list": {"listItems": items}}
    else:
        body = {"text": {"text": text}}

    payload = {"title": title, "body": body}
    t = get_access_token()
    result = http_req("POST", "https://keep.googleapis.com/v1/notes", token=t, body=payload)
    if "error" in result:
        die(result["error"].get("message", str(result)))
    print(f"✓ Created note — {result.get('name')}")


def keep_delete(args):
    if not args:
        die("Usage: google-api keep delete <note-id>")
    note_id = args[0]
    if not note_id.startswith("notes/"):
        note_id = f"notes/{note_id}"
    t = get_access_token()
    result = http_req("DELETE", f"https://keep.googleapis.com/v1/{note_id}", token=t)
    if "error" in result:
        die(result["error"].get("message", str(result)))
    print(f"✓ Deleted {note_id}")


