def cmd_sheets(args):
    sub = args[0] if args else "help"
    rest = args[1:]
    {
        "get":      lambda: sheets_get(rest),
        "update":   lambda: sheets_update(rest),
        "append":   lambda: sheets_append(rest),
        "clear":    lambda: sheets_clear(rest),
        "metadata": lambda: sheets_metadata(rest),
    }.get(sub, lambda: sheets_help())()


def sheets_help():
    print("""\
Usage: google-api sheets <command>

  get <id> <range> [--json]
  update <id> <range> --values-json '[["A","B"],...]'
  append <id> <range> --values-json '[["x","y"],...]'
  clear <id> <range>
  metadata <id>
""")


def sheets_get(args):
    if len(args) < 2:
        die("Usage: google-api sheets get <id> <range>")
    sheet_id, range_ = args[0], args[1]
    as_json = "--json" in args
    t = get_access_token()
    result = http_get(
        f"https://sheets.googleapis.com/v4/spreadsheets/{sheet_id}/values/{urllib.parse.quote(range_)}",
        token=t
    )
    if "error" in result:
        die(result["error"].get("message", str(result)))
    if as_json:
        jprint(result)
        return
    for row in result.get("values", []):
        print("\t".join(str(c) for c in row))


def sheets_update(args):
    if len(args) < 2:
        die("Usage: google-api sheets update <id> <range> --values-json '[...]'")
    sheet_id, range_ = args[0], args[1]
    values_json = ""
    for i, a in enumerate(args):
        if a == "--values-json" and i + 1 < len(args):
            values_json = args[i + 1]
    if not values_json:
        die("--values-json required")
    values = json.loads(values_json)
    t = get_access_token()
    result = http_req("PUT",
        f"https://sheets.googleapis.com/v4/spreadsheets/{sheet_id}/values/{urllib.parse.quote(range_)}",
        token=t, body={"range": range_, "majorDimension": "ROWS", "values": values},
        params={"valueInputOption": "USER_ENTERED"}
    )
    if "error" in result:
        die(result["error"].get("message", str(result)))
    print(f"✓ Updated {result.get('updatedCells', '?')} cells")


def sheets_append(args):
    if len(args) < 2:
        die("Usage: google-api sheets append <id> <range> --values-json '[...]'")
    sheet_id, range_ = args[0], args[1]
    values_json = ""
    for i, a in enumerate(args):
        if a == "--values-json" and i + 1 < len(args):
            values_json = args[i + 1]
    if not values_json:
        die("--values-json required")
    values = json.loads(values_json)
    t = get_access_token()
    result = http_req("POST",
        f"https://sheets.googleapis.com/v4/spreadsheets/{sheet_id}/values/{urllib.parse.quote(range_)}:append",
        token=t, body={"majorDimension": "ROWS", "values": values},
        params={"valueInputOption": "USER_ENTERED", "insertDataOption": "INSERT_ROWS"}
    )
    if "error" in result:
        die(result["error"].get("message", str(result)))
    print(f"✓ Appended {result.get('updates', {}).get('updatedCells', '?')} cells")


def sheets_clear(args):
    if len(args) < 2:
        die("Usage: google-api sheets clear <id> <range>")
    sheet_id, range_ = args[0], args[1]
    t = get_access_token()
    result = http_req("POST",
        f"https://sheets.googleapis.com/v4/spreadsheets/{sheet_id}/values/{urllib.parse.quote(range_)}:clear",
        token=t, body={}
    )
    if "error" in result:
        die(result["error"].get("message", str(result)))
    print(f"✓ Cleared {result.get('clearedRange', range_)}")


def sheets_metadata(args):
    if not args:
        die("Usage: google-api sheets metadata <id>")
    sheet_id = args[0]
    t = get_access_token()
    result = http_get(
        f"https://sheets.googleapis.com/v4/spreadsheets/{sheet_id}",
        token=t, params={"fields": "spreadsheetId,properties,sheets.properties"}
    )
    if "error" in result:
        die(result["error"].get("message", str(result)))
    jprint(result)


